;; Sandbox del visor de artifacts (sandbox-exec). Todo prohibido salvo lo listado: aunque alguien tomara
;; control del proceso, no puede leer el resto del disco (claves, mail, otros repos) ni escribir fuera de
;; los datos del visor. Solo macOS. Parámetros (-D): ART = carpeta de artifacts (con cuentas: ART/<cuenta>/<id>/),
;; VIEWER = esta carpeta, HOME = home del usuario, ARTRE = ART escapado para regex, PY = prefijo de la instalación de Python, LOG = archivo de log, PORT = puerto local.
(version 1)
(deny default)

;; Proceso: solo el intérprete, sin lanzar otros programas.
(allow process-fork)
(allow process-exec (subpath (param "PY")))
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.SystemConfiguration.configd")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.logd"))
(allow ipc-posix-shm-read-data)

;; Lectura: el sistema sí (bibliotecas, certificados, Python); del home del usuario, NADA salvo la carpeta de
;; artifacts y el visor. En SBPL gana la última regla que calza, por eso el orden importa.
(allow file-read*)
(deny file-read* (subpath (param "HOME")) (subpath "/Volumes"))
(allow file-read* (subpath (param "VIEWER")) (subpath (param "ART")))

;; Escritura: solo la db local, los comentarios, los boards de Design (edición desde el lienzo, con su
;; temporal de escritura atómica), la caché de fuentes y el log.
(allow file-write*
  (regex (string-append "^" (param "ARTRE") "/[^/]+/[^/]+/_(db|comments)(/|$)"))
  (regex (string-append "^" (param "ARTRE") "/[^/]+/[^/]+/project/[^/]+[.]dc[.]html([.][0-9a-f]+[.]tmp)?$"))
  (subpath (string-append (param "ART") "/_runtime/fonts"))
  (literal (param "LOG"))
  (literal "/dev/null"))

;; Red: atender solo en 127.0.0.1:PORT; salir solo por HTTPS (Google Fonts) y DNS.
(allow network-bind (local ip (string-append "localhost:" (param "PORT"))))
(allow network-inbound (local ip (string-append "localhost:" (param "PORT"))))
(allow network-outbound (remote tcp "*:443"))
(allow network-outbound (literal "/private/var/run/mDNSResponder"))
(allow system-socket)
