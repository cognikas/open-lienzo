# Copy to .env and adjust. docker compose reads it automatically.

# Your artifacts repo on the host (one folder per claude.ai account, plus _runtime/). Mounted at /data.
LIENZO_DATA=./data
# Name that signs local comments and that claude.use('user') returns.
LIENZO_AUTHOR=Local
# Host port, always bound to 127.0.0.1.
LIENZO_PORT=8765
# Image tag from ghcr.io/cognikas/open-lienzo (a release like 0.1.0, or latest).
OPEN_LIENZO_TAG=latest
# Linux only: the uid/gid that owns LIENZO_DATA (run `id -u` / `id -g`). Docker Desktop ignores it.
LIENZO_UID=10001
LIENZO_GID=10001
